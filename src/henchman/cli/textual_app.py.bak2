    from collections.abc import AsyncIterator

    from henchman.config.schema import Settings
    from henchman.core.session import Session


@dataclass
class TextualConfig:
    """Configuration for the Textual TUI.

    Attributes:
        prompt: The prompt string to display.
        system_prompt: System prompt for the agent.
        auto_save: Whether to auto-save sessions on exit.
        history_file: Path to history file.
        base_tool_iterations: Base limit for tool iterations per turn.
        max_tool_calls_per_turn: Maximum tool calls allowed per turn.
        auto_approve_tools: Auto-approve all tool executions (non-interactive mode).
    """

    prompt: str = "❯ "
    system_prompt: str = ""
    auto_save: bool = True
    history_file: Path | None = None
    base_tool_iterations: int = 25
    max_tool_calls_per_turn: int = 100
    auto_approve_tools: bool = False


class HenchmanTextArea(TextArea):
    """Custom TextArea to handle bindings and interactions correctly."""

    BINDINGS = [
        Binding("ctrl+f", "app.search", "Search", show=False),
        Binding("enter", "submit_message_internal", "Submit Message", show=False),
        Binding("shift+enter", "newline", "Newline", show=False),
        Binding("escape", "app.clear_search", "Clear Search", show=False),
        Binding("up", "history_up", "History Up", show=False),
        Binding("down", "history_down", "History Down", show=False),
    ]

    async def on_key(self, event: events.Key) -> None:
        """Handle key events."""
        if event.key == "enter":
            event.stop()
            event.prevent_default()
            self.app.action_submit_message()
            return
        elif event.key == "shift+enter":
            event.stop()
            event.prevent_default()
            self.insert("\n")
            return

        # Do not call super().on_key(event) as it doesn't exist
        # Let unknown keys bubble up
        pass

    def action_newline(self) -> None:
        """Insert a newline."""
        self.insert("\n")

    def action_history_up(self) -> None:
        """Move cursor up or navigate history."""
        if self.cursor_location[0] == 0:
            self.app._navigate_history(-1)
        else:
            self.action_cursor_up()

    def action_history_down(self) -> None:
        """Move cursor down or navigate history."""
        lines = self.document.line_count - 1
        if self.cursor_location[0] >= lines:
            self.app._navigate_history(1)
        else:
            self.action_cursor_down()

    def on_mount(self) -> None:
        """Initialize the text area when mounted."""
        pass


class AgentContentMessage(Message):
    """Message for agent content events."""

    def __init__(self, content: str, source_agent: str | None = None) -> None:
        """Initialize an agent content message.

        Args:
            content: The content text from the agent.
            source_agent: Optional name of the agent that produced the content.
        """
        super().__init__()
        self.content = content
        self.source_agent = source_agent


class AgentThoughtMessage(Message):
    """Message for agent thought events."""

    def __init__(self, thought: str, source_agent: str | None = None) -> None:
        """Initialize an agent thought message.

        Args:
            thought: The thought/reasoning text from the agent.
            source_agent: Optional name of the agent that produced the thought.
        """
        super().__init__()
        self.thought = thought
        self.source_agent = source_agent


class ToolCallRequestMessage(Message):
    """Message for tool call request events."""

    def __init__(self, tool_call: Any, source_agent: str | None = None) -> None:
        """Initialize a tool call request message.

        Args:
            tool_call: The tool call data (name, arguments, etc.).
            source_agent: Optional name of the agent requesting the tool call.
        """
        super().__init__()
        self.tool_call = tool_call
        self.source_agent = source_agent


class ToolCallResultMessage(Message):
    """Message for tool call result events."""

    def __init__(self, result: Any, source_agent: str | None = None) -> None:
        """Initialize a tool call result message.

        Args:
            result: The result data from the tool execution.
            source_agent: Optional name of the agent that executed the tool.
        """
        super().__init__()
        self.result = result
        self.source_agent = source_agent


class AgentStatusMessage(Message):
    """Message for agent status updates."""

    def __init__(self, status: str, source_agent: str | None = None) -> None:
        """Initialize an agent status message.

        Args:
            status: The status text (e.g., "working", "completed").
            source_agent: Optional name of the agent whose status is being reported.
        """
        super().__init__()
        self.status = status
        self.source_agent = source_agent


class AgentFinishedMessage(Message):
    """Message for agent finished events."""

    def __init__(self, source_agent: str | None = None) -> None:
        """Initialize an agent finished message.

        Args:
            source_agent: Optional name of the agent that finished execution.
        """
        super().__init__()
        self.source_agent = source_agent


