"""Static interface for the dynamically loaded security helpers."""

from collections.abc import Iterable
from pathlib import Path

class SecurityError(Exception): ...
class PathTraversalError(SecurityError): ...
class CommandInjectionError(SecurityError): ...
class SSRFError(SecurityError): ...

def validate_path(path: str | Path, base_dir: str | Path | None = None) -> Path: ...
def sanitize_command(command: str, allowed_commands: Iterable[str] | None = None) -> str: ...
def validate_url(
    url: str,
    allowed_schemes: Iterable[str] = ("http", "https"),
    allowed_domains: Iterable[str] | None = None,
    *,
    block_private_ips: bool = True,
    block_localhost: bool = True,
) -> str: ...
def sanitize_error_message(error: Exception | str) -> str: ...
def atomic_write(
    path: str | Path,
    content: str,
    mode: str = "w",
    encoding: str = "utf-8",
) -> None: ...
def atomic_read(
    path: str | Path,
    mode: str = "r",
    encoding: str = "utf-8",
) -> str: ...
