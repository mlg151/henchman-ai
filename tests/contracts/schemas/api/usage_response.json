{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "henchman/contracts/api/usage-response/v1",
  "type": "object",
  "required": ["total_tokens", "total_cost", "daily_usage"],
  "properties": {
    "total_tokens": {
      "type": "integer"
    },
    "total_cost": {
      "type": "number"
    },
    "daily_usage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["tokens", "cost"],
        "properties": {
          "tokens": { "type": "integer" },
          "cost": { "type": "number" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
