{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "henchman/contracts/api/run-budget-snapshot/v1",
  "type": "object",
  "required": [
    "run_id",
    "limits",
    "consumed_requests",
    "reserved_requests",
    "settled_tokens",
    "held_tokens",
    "unknown_dispatched_requests",
    "unknown_cost_requests",
    "elapsed_seconds",
    "remaining_requests",
    "remaining_tokens",
    "remaining_seconds",
    "remaining_cost",
    "money",
    "stop_reason",
    "accounting_lifetime",
    "accounting_error"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "limits": {
      "type": "object",
      "required": [
        "max_requests",
        "max_tokens",
        "max_seconds",
        "max_cost",
        "currency"
      ],
      "properties": {
        "max_requests": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_cost": {
          "type": [
            "string",
            "null"
          ]
        },
        "currency": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "consumed_requests": {
      "type": "integer",
      "minimum": 0
    },
    "reserved_requests": {
      "type": "integer",
      "minimum": 0
    },
    "settled_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "held_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "unknown_dispatched_requests": {
      "type": "integer",
      "minimum": 0
    },
    "unknown_cost_requests": {
      "type": "integer",
      "minimum": 0
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "remaining_requests": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "remaining_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "remaining_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "remaining_cost": {
      "type": [
        "string",
        "null"
      ]
    },
    "money": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "currency",
          "held_cost",
          "settled_estimated_cost",
          "reported_cost",
          "settled_reported_cost",
          "unknown_cost_requests"
        ],
        "properties": {
          "currency": {
            "type": "string"
          },
          "held_cost": {
            "type": [
              "string",
              "null"
            ]
          },
          "settled_estimated_cost": {
            "type": [
              "string",
              "null"
            ]
          },
          "reported_cost": {
            "type": [
              "string",
              "null"
            ]
          },
          "settled_reported_cost": {
            "type": [
              "string",
              "null"
            ]
          },
          "unknown_cost_requests": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "accounting_lifetime": {
      "type": "string",
      "enum": [
        "process",
        "durable"
      ]
    },
    "accounting_error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
