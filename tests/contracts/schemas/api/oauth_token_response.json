{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "henchman/contracts/api/oauth-token-response/v1",
  "type": "object",
  "required": ["access_token", "token_type", "client_id", "scopes"],
  "properties": {
    "access_token": { "type": "string" },
    "token_type": { "type": "string" },
    "client_id": { "type": "string" },
    "scopes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
