  "$id": "henchman/contracts/extensions/plugin-update-info/v1",
  "title": "PluginUpdateInfo",
  "description": "Version-difference information for one plugin update.",
  "type": "object",
  "properties": {
    "plugin_name": { "type": "string" },
    "current_version": { "type": "string" },
