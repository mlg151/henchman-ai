{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TeamWorkspaceRecord",
  "description": "Persisted metadata for one team workspace.",
  "type": "object",
  "properties": {
    "workspace_id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": ["string", "null"] },
    "members": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "workspace_path": { "type": "string" }
  },
  "required": ["workspace_id", "name", "members", "created_at", "workspace_path"]
}
