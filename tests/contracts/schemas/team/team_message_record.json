{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TeamMessageRecord",
  "description": "Persisted channel message in one team workspace.",
  "type": "object",
  "properties": {
    "message_id": { "type": "string" },
    "workspace_id": { "type": "string" },
    "channel": { "type": "string" },
    "sender": { "type": "string" },
    "body": { "type": "string" },
    "recipients": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["message_id", "workspace_id", "channel", "sender", "body", "recipients", "created_at"]
}
