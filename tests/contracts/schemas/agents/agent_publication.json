{
  "$id": "henchman/contracts/agents/agent-publication/v1",
  "title": "AgentPublication",
  "description": "Shape contract for AgentPublication.",
  "type": "object",
  "required": ["definition", "version", "publication_path"],
  "properties": {
    "definition": {
      "type": "object",
      "description": "The published agent definition",
      "required": ["name", "role", "description", "tools", "enabled", "version"],
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "description": { "type": "string" },
        "system_prompt": { "type": "string" },
        "tools": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "auto_approve": { "type": "array", "items": { "type": "string" } },
        "can_delegate_to": { "type": "array", "items": { "type": "string" } },
        "enabled": { "type": "boolean" },
        "version": { "type": "string" },
        "author": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "source_kind": { "type": "string" },
        "source_path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "version": { "type": "string", "description": "Published version" },
    "publication_path": { "type": "string", "description": "Path or URL to the published bundle" }
  },
  "additionalProperties": false
}
