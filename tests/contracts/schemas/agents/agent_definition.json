{
  "$id": "henchman/contracts/agents/agent-definition/v1",
  "title": "AgentDefinition",
  "description": "Shape contract for the serialised AgentDefinition (to_payload).",
  "type": "object",
  "required": ["name", "role", "description", "tools", "enabled", "version"],
  "properties": {
    "name": { "type": "string", "description": "Display name of the agent" },
    "role": { "type": "string", "description": "Unique role identifier" },
    "description": { "type": "string", "description": "One-line description of the agent's purpose" },
    "system_prompt": { "type": "string", "description": "Role-specific instructions" },
    "tools": {
      "type": "array", "description": "Allowlist of tool names",
      "items": { "type": "string" }, "minItems": 1
    },
    "provider": { "type": "string", "description": "Override model provider" },
    "model": { "type": "string", "description": "Override model name" },
    "auto_approve": {
      "type": "array", "description": "Tools to auto-approve",
      "items": { "type": "string" }
    },
    "can_delegate_to": {
      "type": "array", "description": "Roles this agent can delegate to",
      "items": { "type": "string" }
    },
    "enabled": { "type": "boolean", "description": "Whether this agent is active" },
    "version": { "type": "string", "description": "Semantic version of the definition" },
    "author": { "type": "string", "description": "Author of the agent definition" },
    "tags": {
      "type": "array", "description": "Categorization tags",
      "items": { "type": "string" }
    },
    "source_kind": { "type": "string", "description": "Origin type (e.g. 'local', 'registry')" },
    "source_path": { "type": "string", "description": "Filesystem path or registry URL" }
  },
  "additionalProperties": false
}
