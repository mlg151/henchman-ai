{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NativeSkillYaml",
  "description": "Schema for native Henchman YAML skill definition files.",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "parameters": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          { "type": "object", "additionalProperties": { "type": "string" } }
        ]
      }
    }
  },
  "required": ["description"]
}
