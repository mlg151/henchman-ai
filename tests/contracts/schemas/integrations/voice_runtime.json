{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VoiceRuntimeDescription",
  "description": "Description of the configured voice runtime.",
  "type": "object",
  "properties": {
    "preferred_voice": { "type": ["string", "null"] },
    "tts_command": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "stt_command": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    }
  },
  "required": ["preferred_voice", "tts_command", "stt_command"]
}
