{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProviderMessage",
  "description": "A message in the conversation history.",
  "type": "object",
  "properties": {
    "role": { "type": "string", "enum": ["system", "user", "assistant", "tool"] },
    "content": { "type": ["string", "null"] },
    "tool_calls": {
      "type": ["array", "null"],
      "items": { "$ref": "tool_call" }
    },
    "tool_call_id": { "type": ["string", "null"] },
    "reasoning_content": { "type": ["string", "null"] },
    "reasoning_details": { "type": ["string", "null"] },
    "continuation": {"type": ["object", "null"], "required": ["version", "provider", "model", "profile", "scope_sha256", "request_sha256", "payload_json", "payload_sha256", "status", "reason"], "properties": {"version": {"type": "integer", "enum": [1]}, "provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "profile": {"type": "string", "enum": ["anthropic.messages.v1", "openrouter.reasoning_details.v1", "deepseek.reasoning_content.v1"]}, "scope_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "payload_json": {"type": ["string", "null"]}, "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "status": {"type": "string", "enum": ["complete", "unavailable"]}, "reason": {"type": ["string", "null"], "enum": [null, "redacted_continuation", "incomplete_continuation", "compacted_continuation"]}}, "additionalProperties": false},
    "tool_result": { "type": ["object", "null"], "description": "Optional typed tool evidence; provider adapters render an explicit portable text projection." }
  },
  "required": ["role"]
}
