{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProviderMessage",
  "description": "A message in the conversation history.",
  "type": "object",
  "properties": {
    "role": { "type": "string", "enum": ["system", "user", "assistant", "tool"] },
    "content": { "type": ["string", "null"] },
    "tool_calls": {
      "type": ["array", "null"],
      "items": { "$ref": "tool_call" }
    },
    "tool_call_id": { "type": ["string", "null"] },
    "reasoning_content": { "type": ["string", "null"] },
    "reasoning_details": { "type": ["string", "null"] },
    "continuation": {"type": ["object", "null"], "required": ["version", "provider", "model", "profile", "scope_sha256", "request_sha256", "payload_json", "payload_sha256", "status", "reason"], "properties": {"version": {"type": "integer", "enum": [1]}, "provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "profile": {"type": "string", "enum": ["anthropic.messages.v1", "openrouter.reasoning_details.v1", "deepseek.reasoning_content.v1"]}, "scope_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "payload_json": {"type": ["string", "null"]}, "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "status": {"type": "string", "enum": ["complete", "unavailable"]}, "reason": {"type": ["string", "null"], "enum": [null, "redacted_continuation", "incomplete_continuation", "compacted_continuation"]}}, "additionalProperties": false},
    "tool_result": { "type": ["object", "null"], "description": "Optional typed tool evidence; provider adapters render an explicit portable text projection." },
    "context_attachments": {"type":["array","null"],"minItems":1,"maxItems":256,"items":{"type":"object","additionalProperties":false,"required":["version","preview_id","source","payload","captured_sha256","projection"],"properties":{"version":{"const":1},"preview_id":{"type":"string","pattern":"^[a-f0-9]{32}$"},"source":{"type":"object","additionalProperties":false,"required":["server","protocol_version","connection_generation","catalog_generation","operation","identifier","arguments"],"properties":{"server":{"type":"string","maxLength":4096},"protocol_version":{"enum":["2024-11-05","2025-03-26","2025-06-18","2025-11-25","2026-07-28"]},"connection_generation":{"type":"integer","minimum":0},"catalog_generation":{"type":"integer","minimum":0},"operation":{"enum":["resources/read","prompts/get"]},"identifier":{"type":["string","null"],"maxLength":4096},"arguments":{"type":["object","null"],"additionalProperties":{"type":"string"}}}},"payload":{"type":["object","null"]},"captured_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"projection":{"enum":["text_and_metadata","omitted"]},"source_set_omission":{"type":"object","additionalProperties":false,"required":["input_records","sha256"],"properties":{"input_records":{"type":"integer","minimum":9},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}}}
  },
  "required": ["role"]
}
