{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IntelligentCompactionResult",
  "description": "Result of an intelligent context compaction operation.",
  "type": "object",
  "properties": {
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": { "type": "string" },
          "content": { "type": ["string", "null"] }
        },
        "required": ["role"]
      }
    },
    "was_compacted": { "type": "boolean" },
    "dropped_count": { "type": "integer" },
    "summary": { "type": ["string", "null"] },
    "importance_scores": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "integer" }
      }
    },
    "compression_ratio": { "type": "number" }
  },
  "required": ["messages", "was_compacted", "dropped_count", "importance_scores", "clusters", "compression_ratio"]
}
