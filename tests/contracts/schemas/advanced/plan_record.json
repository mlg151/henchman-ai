{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanRecord",
  "description": "Tracked plan progress with optional acceptance specifications and historical observations; not whole-task certification.",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "index",
          "text",
          "done",
          "evidence",
          "completed_at"
        ]
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/definitions/check"
      }
    },
    "last_verification": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/report"
        }
      ]
    }
  },
  "required": [
    "plan_id",
    "title",
    "created_at",
    "updated_at",
    "steps"
  ],
  "definitions": {
    "check": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "file_exists",
            "file_contains",
            "file_changed",
            "command",
            "pytest"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string"
          }
        },
        "expected_exit": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "baseline_captured": {
          "type": "boolean"
        },
        "baseline_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "baseline_error": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "file_exists",
                  "file_contains",
                  "file_changed",
                  "pytest"
                ]
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "file_contains"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "command"
              }
            }
          },
          "then": {
            "required": [
              "argv"
            ]
          }
        }
      ]
    },
    "report": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "finished",
            "cancelled",
            "error"
          ]
        },
        "checks_passed": {
          "type": "boolean"
        },
        "task_verified": {
          "const": false
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "spec_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "results": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/definitions/result"
          }
        }
      },
      "required": [
        "checks_passed",
        "task_verified",
        "checked_at",
        "results"
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 19
        },
        "check": {
          "$ref": "#/definitions/check"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "passed": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "stdout_truncated": {
          "type": "boolean"
        },
        "stderr_truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "index",
        "check",
        "started_at",
        "checked_at",
        "passed"
      ]
    }
  }
}
