{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpToolResult",
  "description": "Result of calling a tool on an MCP server.",
  "type": "object",
  "properties": {
    "content": { "type": "string" },
    "is_error": { "type": "boolean" },
    "metadata": { "type": ["object", "null"] },
    "content_blocks": { "type": "array", "items": { "type": "object" } },
    "structured_content": {},
    "structured_content_present": { "type": "boolean" }
  },
  "required": ["content", "is_error"]
}
