{
  "$id": "henchman/contracts/runtime/session-metadata/v1",
  "title": "SessionMetadata",
  "description": "Shape contract for SessionMetadata.",
  "type": "object",
  "required": ["id", "project_hash", "started", "last_updated", "message_count"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique session identifier"
    },
    "tag": {
      "type": ["string", "null"],
      "description": "Optional human-readable tag for the session"
    },
    "project_hash": {
      "type": "string",
      "description": "Hash identifying the project"
    },
    "started": {
      "type": "string",
      "description": "ISO-8601 timestamp of when the session started"
    },
    "last_updated": {
      "type": "string",
      "description": "ISO-8601 timestamp of the last update"
    },
    "message_count": {
      "type": "integer",
      "description": "Number of messages in the session",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
