{
  "$id": "henchman/contracts/runtime/session/v1",
  "title": "Session",
  "description": "Shape contract for Session.to_dict().",
  "type": "object",
  "required": ["id", "project_hash", "started", "last_updated", "plan_mode", "plan_mode_origin", "messages", "turn_summaries", "active_agents", "delegation_log", "template_parameters", "export_metadata"],
  "properties": {
    "id": { "type": "string", "description": "Unique session identifier" },
    "tag": { "type": ["string", "null"], "description": "Optional human-readable tag" },
    "project_hash": { "type": "string", "description": "Hash identifying the project" },
    "started": { "type": "string", "description": "ISO-8601 start timestamp" },
    "last_updated": { "type": "string", "description": "ISO-8601 last update timestamp" },
    "plan_mode": { "type": "boolean", "description": "Whether the session is in Plan Mode" },
    "plan_mode_origin": { "type": "string", "enum": ["user", "model"], "description": "Authority that opened the current plan mode" },
    "messages": {
      "type": "array",
      "description": "Conversation messages",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["user", "assistant", "tool", "system"] },
          "content": { "type": ["string", "null"] },
          "tool_calls": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "required": ["name", "arguments"],
              "properties": {
                "id": { "type": ["string", "null"], "description": "Tool call ID pairing the call with its result" },
                "name": { "type": "string" },
                "arguments": { "type": "object", "additionalProperties": true }
              },
              "additionalProperties": false
            }
          },
          "tool_call_id": { "type": ["string", "null"] },
          "agent_id": { "type": ["string", "null"] },
          "reasoning_content": { "type": ["string", "null"] },
          "reasoning_details": { "type": ["string", "null"] },
          "agent_role": { "type": ["string", "null"] },
          "tool_result": { "type": ["object", "null"], "description": "Validated typed result evidence, including structured presence, metadata, and explicit truncation provenance." }
        },
        "additionalProperties": false
      }
    },
    "turn_summaries": {
      "type": "array",
      "description": "Summaries of completed turns",
      "items": {
        "type": "object",
        "required": ["turn_number", "summary_text"],
        "properties": {
          "turn_number": { "type": "integer", "description": "Sequential turn number in session" },
          "summary_text": { "type": "string", "description": "LLM-generated summary of the turn" },
          "files_modified": { "type": "array", "description": "List of files modified during the turn", "items": { "type": "string" } },
          "tool_count": { "type": "integer", "description": "Number of tool calls made" },
          "timestamp": { "type": "string", "description": "ISO timestamp when turn completed" },
          "kind": { "type": "string", "enum": ["turn", "compaction"], "description": "Record kind; legacy records default to 'turn'" },
          "source_turns": { "type": "array", "description": "Absolute 1-based user-anchored turn numbers covered by the record", "items": { "type": "integer", "minimum": 1 } },
          "retained_messages": {
            "type": "array",
            "description": "Original messages retained by a compaction record so its turns stay recoverable",
            "items": {
              "type": "object",
              "required": ["role", "content"],
              "properties": {
                "role": { "type": "string", "enum": ["user", "assistant", "tool", "system"] },
                "content": { "type": ["string", "null"] },
                "tool_calls": {
                  "type": ["array", "null"],
                  "items": {
                    "type": "object",
                    "required": ["name", "arguments"],
                    "properties": {
                      "id": { "type": ["string", "null"], "description": "Tool call ID pairing the call with its result" },
                      "name": { "type": "string" },
                      "arguments": { "type": "object", "additionalProperties": true }
                    },
                    "additionalProperties": false
                  }
                },
                "tool_call_id": { "type": ["string", "null"] },
                "agent_id": { "type": ["string", "null"] },
                "agent_role": { "type": ["string", "null"] },
                "reasoning_content": { "type": ["string", "null"] },
                "reasoning_details": { "type": ["string", "null"] },
                "tool_result": { "type": ["object", "null"], "description": "Typed result evidence retained with the original message, including structured presence and metadata." }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "active_agents": {
      "type": "array",
      "description": "Agent roles active in this session",
      "items": { "type": "string" }
    },
    "operations": {
      "type": "object",
      "description": "Advisory tool-call correlation; the separate operation store remains authoritative.",
      "required": ["persistence", "reference", "bindings", "observed_ids", "conversations"],
      "additionalProperties": false,
      "properties": {
        "persistence": { "type": "string", "enum": ["process", "durable"] },
        "reference": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["store_id", "project_hash", "session_id", "version"],
              "additionalProperties": false,
              "properties": {
                "store_id": { "type": "string" },
                "project_hash": { "type": "string" },
                "session_id": { "type": "string" },
                "version": { "type": "integer", "const": 1 }
              }
            }
          ]
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["operation_id", "context", "assistant_index", "conversation_id"],
            "additionalProperties": false,
            "properties": {
              "operation_id": { "type": "string" },
              "assistant_index": { "type": "integer", "minimum": 0 },
              "conversation_id": { "type": ["string", "null"] },
              "context": {
                "type": "object",
                "required": ["project_hash", "session_id", "run_id", "turn_id", "agent_id", "tool_call_id"],
                "additionalProperties": false,
                "properties": {
                  "project_hash": { "type": "string" },
                  "session_id": { "type": "string" },
                  "run_id": { "type": "string" },
                  "turn_id": { "type": "string" },
                  "agent_id": { "type": "string" },
                  "tool_call_id": { "type": "string" }
                }
              }
            }
          }
        },
        "observed_ids": { "type": "array", "items": { "type": "string" } },
        "conversations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "messages"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "messages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["role"],
                  "additionalProperties": false,
                  "properties": {
                    "role": { "type": "string", "enum": ["user", "assistant", "tool", "system"] },
                    "content": { "type": ["string", "null"] },
                    "tool_calls": { "type": ["array", "null"], "items": { "type": "object", "additionalProperties": true } },
                    "tool_call_id": { "type": ["string", "null"] },
                    "agent_id": { "type": ["string", "null"] },
                    "agent_role": { "type": ["string", "null"] },
                    "reasoning_content": { "type": ["string", "null"] },
                    "reasoning_details": { "type": ["string", "null"] },
                    "tool_result": { "type": ["object", "null"], "description": "Validated typed result evidence, preserving structured missing versus null and explicit truncation provenance." }
                  }
                }
              }
            }
          }
        }
      }
    },
    "delegation_log": {
      "type": "array",
      "description": "Log of delegation operations",
      "items": { "type": "object", "additionalProperties": true }
    },
    "parent_id": { "type": ["string", "null"], "description": "Parent session ID if branched" },
    "branch_point": { "type": ["integer", "null"], "description": "Message index where branch occurred", "minimum": 0 },
    "template_id": { "type": ["string", "null"], "description": "Template ID if created from template" },
    "template_parameters": { "type": "object", "description": "Template instantiation parameters", "additionalProperties": true },
    "export_metadata": {
      "type": "object",
      "description": "Metadata for export/import operations",
      "additionalProperties": true,
      "properties": {
        "session_memories": {
          "type": "array",
          "description": "Persisted per-session memory records",
          "items": {
            "type": "object",
            "required": ["id", "content", "kind", "source", "created_at"],
            "properties": {
              "id": { "type": "string" },
              "content": { "type": "string" },
              "kind": { "type": "string" },
              "source": { "type": "string" },
              "created_at": { "type": "string" },
              "message_index": { "type": ["integer", "null"] }
            },
            "additionalProperties": false
          }
        },
        "memory_extraction_opt_out": { "type": "boolean", "description": "Persisted extraction/persistence opt-out flag" }
      }
    }
  },
  "additionalProperties": false
}
