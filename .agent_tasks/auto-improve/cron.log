bytes]:\n        """Communicate with process with optional timeout."""\n        
effective_timeout: float | None = None if timeout == 0 else timeout\n        if 
effective_timeout is not None:\n            return await 
asyncio.wait_for(process.communicate(), timeout=effective_timeout)\n        
else:\n            return await process.communicate()\n\n    def 
_process_output(self, stdout: bytes, stderr: bytes) -> str:\n        """Process 
and combine stdout/stderr output."""\n        stdout_text = 
stdout.decode("utf-8", errors="replace")\n        stderr_text = 
stderr.decode("utf-8", errors="replace")\n\n        parts = []\n        if 
stdout_text:\n            parts.append(stdout_text)\n        if stderr_text:\n  
parts.append(stderr_text)\n\n        output = "\\n".join(parts) if parts else 
"(no output)"\n        return self._truncate_output(output)\n\n    def 
