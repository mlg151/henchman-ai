sections = self._generate_symbol_table(tree, file_path.name, 
include_docstrings)\n\n        return ToolResult(\n            
content="\\n".join(sections),\n            success=True,\n        )\n\n    def 
_validate_path(self, path: str) -> ToolResult | None:\n        """Validate the 
provided file path.\n\n        Args:\n            path: Path to validate.\n\n   
Returns:\n            ToolResult with error if validation fails, None if 
valid.\n        """\n        if not path:\n            return ToolResult(\n     
content="Error: No path provided",\n                success=False,\n            
error="Empty path",\n            )\n\n        file_path = Path(path)\n        if
not file_path.exists():\n            return ToolResult(\n                
