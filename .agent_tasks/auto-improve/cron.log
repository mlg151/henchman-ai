importance_scores[i] = score\n\n        return importance_scores\n\n    def 
_calculate_message_importance(\n        self, message: Message, index: int, 
total_messages: int\n    ) -> float:\n        """Calculate importance score for 
a single message.\n\n        Args:\n            message: The message to score.\n
index: Position of the message in the conversation.\n            total_messages:
Total number of messages in the conversation.\n\n        Returns:\n            
Importance score between 0.0 and 1.0.\n        """\n        # Start with base 
score from role and content features\n        score = 
