async def _run_pytest(self, config: PytestConfig) -> ToolResult:\n        """Run
pytest with the given configuration."""\n        if not config.path:\n          
return ToolResult(\n                content="Error: No test path provided",\n   
success=False,\n                error="Empty path",\n            )\n\n        
cmd = self._build_pytest_command(config)\n        \n        try:\n            
return await self._execute_pytest_command(cmd, config)\n        except Exception
as e:  # pragma: no cover\n            return ToolResult(\n                
content=f"Error running pytest: {e}",\n                success=False,\n         
error=str(e),\n            )\n\n    def _build_pytest_command(self, config: 
PytestConfig) -> list[str]:\n        """Build the pytest command line 
arguments."""\n        cmd = [sys.executable, "-m", "pytest", config.path]\n    
\n        if not config.collect_only:\n            cmd.append("-x")\n        if 
config.verbose:\n            cmd.append("-v")\n        if config.keyword:\n     
cmd.extend(["-k", config.keyword])\n        if config.markers:\n            
cmd.extend(["-m", config.markers])\n        if config.coverage:\n            
cov_arg = f"--cov={config.coverage_source}" if config.coverage_source else 
"--cov"\n            cmd.extend([cov_arg, "--cov-report=term-missing"])\n       
if config.parallel is not None and config.parallel > 0:\n            
cmd.extend(["-n", str(config.parallel)])\n        if config.collect_only:\n     
cmd.append("--collect-only")\n            cmd.append("-q")\n            \n      
return cmd\n\n    async def _execute_pytest_command(self, cmd: list[str], 
config: PytestConfig) -> ToolResult:\n        """Execute the pytest command and 
handle timeout."""\n        process = await asyncio.create_subprocess_exec(\n   
*cmd,\n            stdout=asyncio.subprocess.PIPE,\n            
stderr=asyncio.subprocess.PIPE,\n        )\n\n        try:\n            stdout, 
stderr = await self._communicate_with_timeout(process, config.timeout)\n        
