```python
@dataclass
class DelegationExecutionParams:
    """Parameters for executing a delegation flow."""
    target: str
    task: str
    tool_call: ToolCall
    depth: int
    agent: Agent | None = None
    ledger_record: DelegationRecord | None = None

    @property
    def has_agent(self) -> bool:
        return self.agent is not None

    @property
    def has_ledger_record(self) -> bool:
        return self.ledger_record is not None

# Updated method signatures:
async def _execute_delegation_flow(
    self,
    params: DelegationExecutionParams,
) -> AsyncIterator[AgentEvent]:

async def _execute_delegation(
    self,
    params: DelegationExecutionParams,
) -> AsyncIterator[AgentEvent]:
```

