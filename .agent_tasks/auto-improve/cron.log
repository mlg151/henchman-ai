'"""Lazy import utilities for Textual dev mode and other dynamic 
imports."""\n\nfrom typing import Any\n\n\ndef 
create_lazy_getattr(app_class_path: str, app_class_name: str) -> Any:\n    
"""Create a __getattr__ function for lazy importing of Textual apps.\n    \n    
Args:\n        app_class_path: The module path to import (e.g., 
\'henchman.cli.textual_app\')\n        app_class_name: The class name to return 
(e.g., \'HenchmanTextualApp\')\n        \n    Returns:\n        A __getattr__ 
function that lazily imports the specified app class.\n        \n    Example:\n 
__getattr__ = create_lazy_getattr(\n            \'henchman.cli.textual_app\', \n
\'HenchmanTextualApp\'\n        )\n    """\n    \n    def __getattr__(name: str)
-> Any:\n        """Lazy import for Textual dev mode (``textual run 
henchman``)."""\n        if name == "app":\n            # Import the module 
dynamically\n            module = __import__(app_class_path, 
fromlist=[app_class_name])\n            # Get the class from the module\n       
app_class = getattr(module, app_class_name)\n            return app_class\n     
raise AttributeError(f"module {__name__!r} has no attribute {name!r}")\n    \n  
return __getattr__'})

